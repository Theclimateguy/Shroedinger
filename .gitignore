*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.run.xml
*.synctex.gz
*.toc
manuscript/*.pdf

# Word lock files
~$*

# Third-party journal rule files (not redistributed; see docs/journal/README.md)
docs/journal/*.pdf
docs/journal/*.txt

