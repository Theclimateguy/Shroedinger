# Tracked manuscript source snapshot lives in manuscript/.
# Local LaTeX build outputs remain ignored by the rules below.

# Local environment and data artifacts
.venv/
data/
legacy/

# Legacy/original scripts are not part of the clean repository scope
experiments/

# Exploratory script not part of canonical experiment set
clean_experiments/experiment_QFT_free_chain.py

# Generated experiment artifacts are local-only
clean_experiments/out/
clean_experiments/results/**
!clean_experiments/results/
!clean_experiments/results/**/
